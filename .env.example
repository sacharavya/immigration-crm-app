# ---------------------------------------------------------------------------
# Hosts
# ---------------------------------------------------------------------------
# Where the app itself lives: staff login, the operator portal, and every
# tokenised client link (pay, upload, intake, sign). One host, registered once
# as the OAuth redirect origin. e.g. https://app.casebindsystems.com
NEXT_PUBLIC_APP_URL=

# The base domain firms' public pages hang off: each firm is reachable at
# https://<slug>.<PLATFORM_DOMAIN> for its booking page, contact form and NOC
# finder, unless it has a custom domain set by the operator. Needs a wildcard
# DNS record (*.<domain>) pointing at the deployment and the same wildcard
# added as a domain on the Vercel project.
#
# Local development: leave this blank and use <slug>.localhost:3000 — Chrome
# and Firefox resolve any *.localhost name with no setup. Safari needs one
# /etc/hosts line per firm.
PLATFORM_DOMAIN=casebindsystems.com

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Default document storage: the platform's object store (Cloudflare R2)
# ---------------------------------------------------------------------------
# Every firm's documents go here unless the firm connects its own Microsoft
# 365 / Google Workspace account or names a OneDrive library. Any S3-shaped
# store works; for R2 the endpoint is the account's S3 API URL and the bucket
# is the last path segment of the URL Cloudflare shows.
R2_ENDPOINT=https://777e7425417da33e661d6714c5d70e9f.r2.cloudflarestorage.com
R2_BUCKET=casebind
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Microsoft Graph (only needed for the legacy platform OneDrive library)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Email/UPN of the user whose OneDrive holds case files (e.g. info@casebindsystems.com)
GRAPH_ONEDRIVE_USER=
# Drive id returned by `npm run graph:test` after GRAPH_ONEDRIVE_USER is set
GRAPH_DOCUMENT_LIBRARY_ID=
# Optional: anchor case folders inside this top-level folder in the drive.
# Useful for sandboxing during development (e.g. "Test-CRM"). Leave blank to
# anchor at drive root. Slashes allowed for nesting: "Sandbox/Cases".
GRAPH_ROOT_FOLDER=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Groq (LLM for NOC keyword extraction)
GROQ_API_KEY=

# Error monitoring (Sentry)
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Firm-connected accounts (per-tenant Microsoft 365 / Google Workspace)
# ---------------------------------------------------------------------------
# A firm connects its own account from Settings → Site settings. Their client
# documents then go to their own drive and client email is sent from their
# own address, instead of the platform's.

# Encrypts stored refresh tokens (AES-256-GCM) and signs the OAuth state.
# Generate with:  openssl rand -base64 48
# Losing this key invalidates every stored connection; firms must reconnect.
TOKEN_ENCRYPTION_KEY=

# Microsoft: an app registration at https://entra.microsoft.com
#   Supported account types: "Accounts in any organizational directory and
#     personal Microsoft accounts"
#   Redirect URI (Web):  https://<your host>/api/connect/microsoft/callback
#   API permissions (delegated): openid, email, profile, offline_access,
#     Files.ReadWrite.All, Mail.Send
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# Google: an OAuth client (Web application) at https://console.cloud.google.com
#   Enable the Google Drive API and Gmail API on the project.
#   Authorised redirect URI:  https://<your host>/api/connect/google/callback
#   OAuth consent screen scopes: openid, email, profile,
#     https://www.googleapis.com/auth/drive.file,
#     https://www.googleapis.com/auth/gmail.send
#   While the consent screen is in "Testing", only listed test users can
#   connect; publish it before onboarding real firms.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
