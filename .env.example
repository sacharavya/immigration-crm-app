# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Microsoft Graph
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# Email/UPN of the user whose OneDrive holds case files (e.g. info@genzdatalabs.com)
GRAPH_ONEDRIVE_USER=
# Drive id returned by `npm run graph:test` after GRAPH_ONEDRIVE_USER is set
GRAPH_DOCUMENT_LIBRARY_ID=
# Optional: anchor case folders inside this top-level folder in the drive.
# Useful for sandboxing during development (e.g. "Test-CRM"). Leave blank to
# anchor at drive root. Slashes allowed for nesting: "Sandbox/Cases".
GRAPH_ROOT_FOLDER=

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_ADDRESS=

# Groq (LLM for NOC keyword extraction)
GROQ_API_KEY=

# Error monitoring (Sentry)
SENTRY_DSN=

# ---------------------------------------------------------------------------
# Firm-connected accounts (per-tenant Microsoft 365 / Google Workspace)
# ---------------------------------------------------------------------------
# A firm connects its own account from Settings → Site settings. Their client
# documents then go to their own drive and client email is sent from their
# own address, instead of the platform's.

# Encrypts stored refresh tokens (AES-256-GCM) and signs the OAuth state.
# Generate with:  openssl rand -base64 48
# Losing this key invalidates every stored connection; firms must reconnect.
TOKEN_ENCRYPTION_KEY=

# Microsoft: an app registration at https://entra.microsoft.com
#   Supported account types: "Accounts in any organizational directory and
#     personal Microsoft accounts"
#   Redirect URI (Web):  https://<your host>/api/connect/microsoft/callback
#   API permissions (delegated): openid, email, profile, offline_access,
#     Files.ReadWrite.All, Mail.Send
MS_OAUTH_CLIENT_ID=
MS_OAUTH_CLIENT_SECRET=

# Google: an OAuth client (Web application) at https://console.cloud.google.com
#   Enable the Google Drive API and Gmail API on the project.
#   Authorised redirect URI:  https://<your host>/api/connect/google/callback
#   OAuth consent screen scopes: openid, email, profile,
#     https://www.googleapis.com/auth/drive.file,
#     https://www.googleapis.com/auth/gmail.send
#   While the consent screen is in "Testing", only listed test users can
#   connect; publish it before onboarding real firms.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
